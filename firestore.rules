rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks if request has a Firebase Auth session
    function isAuthenticated() {
      return request.auth != null;
    }

    // ============================================================
    // USERS COLLECTION
    // Supports doc IDs as users/{uid} OR users/{phone_doc_id}
    // ============================================================
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    // ============================================================
    // PRODUCTS COLLECTION (Marketplace & Stock Management)
    // ============================================================
    match /products/{productId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    // ============================================================
    // ORDERS COLLECTION (Order Creation & Atomic Transactions)
    // ============================================================
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    // ============================================================
    // DELIVERIES COLLECTION (Delivery Partner & Tracking)
    // ============================================================
    match /deliveries/{deliveryId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    // ============================================================
    // TRACEABILITY & OTHER COLLECTIONS
    // ============================================================
    match /batches/{batchId} {
      allow read, write: if true;
    }

    match /harvest_batches/{batchId} {
      allow read, write: if true;
    }

    match /organic_certificates/{certificateId} {
      allow read, write: if true;
    }

    match /quality_complaints/{complaintId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAuthenticated();
    }

    match /cart/{userId}/items/{itemId} {
      allow read, write: if true;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
